@using codeMRI.Frontend.Services
@using codeMRI.Server.Api
@inject AppState AppState
@inject WikiApiClient WikiApi

<div class="wiki-tree h-100 d-flex flex-column">
    <div class="search-container p-3 border-bottom">
        <div class="input-group input-group-sm">
            <input @bind="searchTerm" @bind:event="oninput" 
                   class="form-control" 
                   placeholder="Filter pages..." 
                   style="border-radius: 4px;" />
        </div>
    </div>
    
    <div class="flex-grow-1 overflow-auto p-2 custom-scrollbar">
        @if (AppState.Structure == null)
        {
            <div class="text-muted small text-center mt-4">Loading structure...</div>
        }
        else
        {
            <ul class="list-unstyled">
                @foreach (var wikiSection in FilteredSections)
                {
                    @RenderSection(wikiSection)
                }
            </ul>
        }
    </div>
</div>

@{
    RenderFragment RenderSection(WikiSection currentSection) => __builder =>
    {
        var hasPages = currentSection.PageRefs.Any();
        var hasSubSections = currentSection.SubSections.Any();
        
        if (!hasPages && !hasSubSections) return;

        <li class="mb-2">
            <div class="section-title">@currentSection.Title</div>
            <ul class="list-unstyled ms-1 border-start ps-2" style="border-color: #f1f3f4 !important;">
                @foreach (var pageId in currentSection.PageRefs)
                {
                    var pageMetadata = GetPageById(pageId);
                    if (pageMetadata == null) continue;
                    if (!Match(pageMetadata.Title)) continue;
                    
                    <li class="wiki-item @(AppState.CurrentPage?.Id == pageId ? "active" : "")" 
                        @onclick="() => LoadPage(pageId)">
                        <div class="d-flex align-items-start">
                            <div class="flex-grow-1">
                                <div class="page-title">@pageMetadata.Title</div>
                                @if (pageMetadata != null)
                                {
                                    @if (!string.IsNullOrEmpty(pageMetadata.Description))
                                    {
                                        <div class="page-description text-muted small">
                                            @(pageMetadata.Description.Length > 60 
                                                ? pageMetadata.Description.Substring(0, 60) + "..." 
                                                : pageMetadata.Description)
                                        </div>
                                    }
                                    @if (pageMetadata.RelevantFiles?.Count > 0)
                                    {
                                        <div class="page-files text-muted small">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                            </svg>
                                            @pageMetadata.RelevantFiles.Count file@(pageMetadata.RelevantFiles.Count != 1 ? "s" : "")
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </li>
                }

                @foreach (var subSection in currentSection.SubSections)
                {
                    @RenderSection(subSection)
                }
            </ul>
        </li>
    };
}

<style>
    .section-title {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #5f6368;
        margin-top: 8px;
        margin-bottom: 4px;
        letter-spacing: 0.5px;
    }
    
    .page-title {
        font-weight: 500;
    }
    
    .page-description {
        font-size: 0.75rem;
        line-height: 1.2;
        margin-top: 2px;
        opacity: 0.8;
    }
    
    .page-files {
        font-size: 0.7rem;
        margin-top: 2px;
        opacity: 0.7;
    }
    
    .wiki-item {
        padding: 8px 12px;
        margin: 2px 0;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    
    .wiki-item:hover {
        background-color: rgba(0, 0, 0, 0.05);
    }
    
    .wiki-item.active {
        background-color: rgba(103, 58, 183, 0.1);
        border-left: 3px solid #673ab7;
    }
</style>

@code {
    private string searchTerm = "";

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
    
    private bool Match(string title)
    {
        if (string.IsNullOrWhiteSpace(searchTerm)) return true;
        return title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<WikiSection> FilteredSections
    {
        get
        {
            if (AppState.Structure == null) return Enumerable.Empty<WikiSection>();
            
            if (string.IsNullOrWhiteSpace(searchTerm))
                return AppState.Structure.Sections;

            return AppState.Structure.Sections.Where(s => IsSectionMatch(s));
        }
    }

    private bool IsSectionMatch(WikiSection section)
    {
        if (section.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) return true;
        if (section.PageRefs.Any(p => {
            var page = GetPageById(p);
            return page != null && page.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
        })) return true;
        
        return section.SubSections.Any(ss => IsSectionMatch(ss));
    }

    private WikiPage? GetPageById(string pageId)
    {
        return AppState.Structure?.Pages?.FirstOrDefault(p => p.Id == pageId);
    }
    
    private WikiPage? GetPageByTitle(string pageTitle)
    {
        return AppState.Structure?.Pages?.FirstOrDefault(p => p.Title == pageTitle);
    }

    private async Task LoadPage(string pageId)
    {
        if (AppState.IsBusy) return;

        // Get page from structure
        var page = GetPageById(pageId);
        if (page == null) return;
        
        // If page has content, display it immediately
        if (!string.IsNullOrEmpty(page.Content))
        {
            AppState.SetCurrentPage(page);
            return;
        }

        // If no content, fetch/generate it
        AppState.SetBusy(true, $"Loading '{page.Title}'...");
        
        try
        {
            var fetchedPage = await WikiApi.GeneratePageAsync(AppState.RepoPath, page.Title, page.RelevantFiles);
            
            // Update cache
            if (AppState.Structure?.Pages != null)
            {
                var index = AppState.Structure.Pages.FindIndex(p => p.Id == pageId);
                if (index != -1)
                {
                    AppState.Structure.Pages[index] = fetchedPage;
                }
                else
                {
                    AppState.Structure.Pages.Add(fetchedPage);
                }
            }
            
            AppState.SetCurrentPage(fetchedPage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading page: {ex.Message}");
        }
        finally
        {
            AppState.SetBusy(false);
        }
    }
}
