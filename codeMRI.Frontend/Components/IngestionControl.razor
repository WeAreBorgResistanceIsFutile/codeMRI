@using codeMRI.Frontend.Services
@using codeMRI.Server.Api
@inject AppState AppState
@inject WikiApiClient WikiApi

<div class="card shadow-sm" style="max-width: 600px; margin: 0 auto;">
    <div class="card-body">
        <h4 class="card-title mb-4">Repository Management</h4>

        <div class="mb-3">
            <label class="form-label">Repository Path (Local)</label>
            <input @bind="repoPath" class="form-control" placeholder="/path/to/repo" disabled="@AppState.IsBusy" />
        </div>

        <div class="d-grid gap-2">
            <button class="btn btn-primary" @onclick="() => IngestRepo()" disabled="@AppState.IsBusy">
                @(AppState.IsBusy ? "Processing..." : "Smart Ingest & Load")
            </button>
            
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-outline-warning flex-grow-1" @onclick="() => IngestRepo(true)" disabled="@AppState.IsBusy">
                    Force Re-ingest
                </button>
                <button class="btn btn-outline-danger flex-grow-1" @onclick="() => IngestRepo(false, true)" disabled="@AppState.IsBusy">
                    Delete Data
                </button>
            </div>
            
            <button class="btn btn-secondary mt-2" @onclick="GenerateStructure" disabled="@(AppState.IsBusy || string.IsNullOrEmpty(repoPath))">
                Regenerate Structure
            </button>
        </div>
        
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="alert alert-danger mt-3">@errorMsg</div>
        }
    </div>
</div>

@code {
    private string repoPath = "";
    private string errorMsg = "";

    protected override void OnInitialized()
    {
        repoPath = AppState.RepoPath;
    }

    private async Task IngestRepo(bool force = false, bool delete = false)
    {
        if (string.IsNullOrEmpty(repoPath)) return;
        
        AppState.SetRepoPath(repoPath);
        AppState.SetBusy(true, delete ? "Deleting data..." : "Ingesting repository...");
        errorMsg = "";

        try
        {
            // 1. Ingest
            var msg = await WikiApi.IngestRepoAsync(repoPath, force, delete);
            
            if (!delete)
            {
                // 2. Generate Structure automatically after ingest if not deleting
                AppState.SetBusy(true, "Generating structure...");
                var structure = await WikiApi.GenerateStructureAsync(repoPath);
                AppState.SetStructure(structure);
            }
            else
            {
                AppState.SetStructure(null!);
            }
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
        finally
        {
            AppState.SetBusy(false);
        }
    }

    private async Task GenerateStructure()
    {
        if (string.IsNullOrEmpty(repoPath)) return;
        
        AppState.SetBusy(true, "Regenerating structure...");
        errorMsg = "";

        try
        {
            var structure = await WikiApi.GenerateStructureAsync(repoPath);
            AppState.SetStructure(structure);
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
        finally
        {
            AppState.SetBusy(false);
        }
    }
}
