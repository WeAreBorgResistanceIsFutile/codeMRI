@using codeMRI.Frontend.Services
@using codeMRI.Server.Api
@inject AppState AppState
@inject WikiApiClient WikiApi

<div class="card shadow-sm" style="max-width: 600px; margin: 0 auto;">
    <div class="card-body">
        <h4 class="card-title mb-4">Repository Management</h4>

        <div class="mb-3">
            <label class="form-label">Repository Path (Local)</label>
            <input @bind="repoPath" class="form-control" placeholder="/path/to/repo" disabled="@AppState.IsBusy" />
        </div>

        <div class="d-grid gap-2">
            <button class="btn btn-primary" @onclick="() => IngestRepo()" disabled="@AppState.IsBusy">
                @(AppState.IsBusy ? "Processing..." : "Smart Ingest & Load")
            </button>
            
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-outline-warning flex-grow-1" @onclick="() => IngestRepo(true)" disabled="@AppState.IsBusy">
                    Force Re-ingest
                </button>
                <button class="btn btn-outline-danger flex-grow-1" @onclick="() => IngestRepo(false, true)" disabled="@AppState.IsBusy">
                    Delete Data
                </button>
            </div>
            
            <button class="btn btn-secondary mt-2" @onclick="GenerateStructure" disabled="@(AppState.IsBusy || string.IsNullOrEmpty(repoPath))">
                Regenerate Structure
            </button>
        </div>
        
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="alert alert-danger mt-3">@errorMsg</div>
        }

        @if (ingestionStatus != null && (AppState.IsBusy || ingestionStatus.Status == "processing"))
        {
            <div class="mt-4">
                <div class="d-flex justify-content-between mb-1">
                    <span>Status: <strong>@ingestionStatus.Status</strong></span>
                    <span>@ingestionStatus.ProcessedFiles / @ingestionStatus.TotalFiles files</span>
                </div>
                <div class="progress" style="height: 20px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                         role="progressbar" 
                         style="width: @(ingestionStatus.ProgressPercentage)%">
                        @Math.Round(ingestionStatus.ProgressPercentage)%
                    </div>
                </div>
                @if (ingestionStatus.FailedFiles > 0)
                {
                    <div class="text-danger small mt-1">
                        Failed: @ingestionStatus.FailedFiles files
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string repoPath = "";
    private string errorMsg = "";
    private IngestionStatusResponse? ingestionStatus;
    private bool isPolling = false;

    protected override void OnInitialized()
    {
        repoPath = AppState.RepoPath;
    }

    private async Task IngestRepo(bool force = false, bool delete = false)
    {
        if (string.IsNullOrEmpty(repoPath)) return;
        
        AppState.SetRepoPath(repoPath);
        AppState.SetBusy(true, delete ? "Deleting data..." : "Ingesting repository...");
        errorMsg = "";
        ingestionStatus = null;

        try
        {
            if (delete)
            {
                await WikiApi.IngestRepoAsync(repoPath, force, delete);
                AppState.SetStructure(null!);
            }
            else
            {
                // Start ingestion and polling in parallel
                var ingestTask = WikiApi.IngestRepoAsync(repoPath, force, delete);
                
                // Poll while ingestion is running
                isPolling = true;
                _ = PollStatusAsync(); // Fire and forget polling loop

                var msg = await ingestTask;
                isPolling = false; // Stop polling
                
                // Final status update
                ingestionStatus = await WikiApi.GetIngestionStatusAsync(repoPath);

                // 2. Generate Structure automatically after ingest
                AppState.SetBusy(true, "Generating structure...");
                var structure = await WikiApi.GenerateStructureAsync(repoPath);
                AppState.SetStructure(structure);
            }
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
            isPolling = false;
        }
        finally
        {
            AppState.SetBusy(false);
        }
    }

    private async Task PollStatusAsync()
    {
        while (isPolling)
        {
            try
            {
                ingestionStatus = await WikiApi.GetIngestionStatusAsync(repoPath);
                StateHasChanged();
                
                if (ingestionStatus.Status == "completed" || ingestionStatus.Status == "error")
                {
                    // If backend says done, we can stop polling, but we usually wait for the main task to return.
                    // However, if the main task is stuck, this helps show completion.
                }
            }
            catch (Exception)
            {
                // Ignore polling errors
            }
            
            await Task.Delay(1000);
        }
    }

    private async Task GenerateStructure()
    {
        if (string.IsNullOrEmpty(repoPath)) return;
        
        AppState.SetBusy(true, "Regenerating structure...");
        errorMsg = "";

        try
        {
            var structure = await WikiApi.GenerateStructureAsync(repoPath);
            AppState.SetStructure(structure);
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
        finally
        {
            AppState.SetBusy(false);
        }
    }
}
