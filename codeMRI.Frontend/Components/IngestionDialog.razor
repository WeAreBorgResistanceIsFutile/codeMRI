@using codeMRI.Frontend.Services
@using codeMRI.Server.Api
@inject WikiApiClient WikiApi
@inject WikiHubClient WikiHub
@inject AppState AppState

<!-- Modal Backdrop -->
<div class="modal-backdrop fade show" @onclick="Close"></div>

<!-- Modal Dialog -->
<div class="modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">Repository Ingestion</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                
                <!-- Main Ingestion Form -->
                @if (currentJob == null)
                {
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Repository Git URL</label>
                        <input type="text" class="form-control form-control-lg" 
                               placeholder="e.g., https://github.com/user/repo" 
                               @bind="repoInput" @bind:event="oninput" />
                        <div class="form-text">Enter a public Git repository URL.</div>
                    </div>


                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }
                    
                    <div class="d-flex justify-content-end mb-4">
                         <button type="button" class="btn btn-primary btn-lg" 
                                 @onclick="StartIngestion" 
                                 disabled="@string.IsNullOrWhiteSpace(repoInput)">
                            Start Ingestion
                        </button>
                    </div>
                }
                else
                {
                    <!-- Active Job Progress -->
                    <div class="text-center py-4">
                        <h5 class="mb-3">Ingesting @currentJob.RepoName</h5>
                        
                        <div class="progress mb-3" style="height: 30px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated @GetStatusColor(currentJob.Status)" 
                                 role="progressbar" 
                                 style="width: @(currentJob.ProgressPercentage)%"
                                 aria-valuenow="@currentJob.ProgressPercentage" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                                <strong>@currentJob.ProgressPercentage%</strong>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between text-muted mb-4">
                            <span>@currentJob.CurrentPhase</span>
                            <small>@currentJob.Message</small>
                        </div>

                        @if (currentJob.Status == IngestionStatus.Failed || currentJob.Status == IngestionStatus.Cancelled)
                        {
                            <div class="alert alert-warning">
                                <strong>Stopped:</strong> @(currentJob.Error ?? currentJob.Message)
                            </div>
                            <button class="btn btn-secondary" @onclick="ResetForm">Try Another</button>
                        }
                        else if (currentJob.Status == IngestionStatus.Completed)
                        {
                             <div class="alert alert-success">
                                <strong>Success!</strong> Ingestion complete.
                            </div>
                            <button class="btn btn-success" @onclick="() => OnIngestionComplete.InvokeAsync(currentJob.RepoPath)">Open Repository</button>
                        }
                        else
                        {
                            <!-- Cancellation -->
                            <button class="btn btn-outline-danger" @onclick="() => CancelJob(currentJob.Id)">
                                Cancel Ingestion
                            </button>
                        }
                    </div>
                }

                <hr />

                <!-- Active Ingestions List -->
                <h6 class="mb-3 text-muted">Active Ingestions on Server</h6>
                @if (activeJobs == null)
                {
                     <div class="text-center"><small>Loading...</small></div>
                }
                else if (!activeJobs.Any(j => (currentJob == null || j.Id != currentJob.Id) && 
                                             j.Status != IngestionStatus.Completed && 
                                             j.Status != IngestionStatus.Failed && 
                                             j.Status != IngestionStatus.Cancelled))
                {
                     <div class="text-center text-muted"><small>No other truly active ingestions.</small></div>
                }
                else
                {
                    <div class="list-group list-group-flush small" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var job in activeJobs.Where(j => (currentJob == null || j.Id != currentJob.Id) && 
                                                                j.Status != IngestionStatus.Completed && 
                                                                j.Status != IngestionStatus.Failed && 
                                                                j.Status != IngestionStatus.Cancelled))
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@job.RepoUrl</strong>
                                    <div class="text-muted">@job.Status - @job.CurrentPhase (@job.ProgressPercentage%)</div>
                                </div>
                                @if (job.Status != IngestionStatus.Completed && job.Status != IngestionStatus.Failed && job.Status != IngestionStatus.Cancelled)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelJob(job.Id)">Cancel</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
</div>



@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnIngestionComplete { get; set; }
    [Parameter] public string DefaultValue { get; set; } = "";

    private string repoInput = "";
    private AudienceType selectedAudience = AudienceType.All;
    private string errorMessage = "";
    private IngestionJob? currentJob = null;
    private List<IngestionJob>? activeJobs;
    private System.Threading.Timer? _pollingTimer;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DefaultValue))
        {
            repoInput = DefaultValue;
        }

        await LoadActiveJobs();
        // Simple polling for the list update
        _pollingTimer = new System.Threading.Timer(async _ => await InvokeAsync(LoadActiveJobs), null, 2000, 2000);
        
        WikiHub.OnAgentStatus += HandleHubMessage; 
    }

    private void HandleHubMessage(AgentMessage msg)
    {
        // For now, any message triggers a refresh if relevant
        // Logic can be refined to check message type
        _ = InvokeAsync(LoadActiveJobs);
    }

    private async Task LoadActiveJobs()
    {
        try
        {
            activeJobs = await WikiApi.ListActiveIngestionsAsync();
            
            // Also update current job if it exists
            if (currentJob != null)
            {
                var updated = activeJobs.FirstOrDefault(j => j.Id == currentJob.Id);
                if (updated != null)
                {
                     currentJob = updated;
                     if (currentJob.Status == IngestionStatus.Completed)
                     {
                         // Stop polling aggressively if done, or auto-redirect
                     }
                }
            }
            StateHasChanged();
        }
        catch (Exception ex) 
        { 
            Console.WriteLine("Failed to load jobs: " + ex.Message); 
        }
    }

    private async Task StartIngestion()
    {
        errorMessage = "";
        try
        {
            currentJob = await WikiApi.StartIngestionAsync(repoInput, selectedAudience);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CancelJob(string jobId)
    {
        if (JSRuntime == null) return;
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to stop this ingestion?"))
        {
            await WikiApi.CancelIngestionAsync(jobId);
            await LoadActiveJobs(); // Refresh immediately
        }
    }

    private void ResetForm()
    {
        currentJob = null;
        repoInput = "";
        errorMessage = "";
    }
    
    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private string GetStatusColor(IngestionStatus status) => status switch
    {
        IngestionStatus.Completed => "bg-success",
        IngestionStatus.Failed => "bg-danger",
        IngestionStatus.Cancelled => "bg-warning",
        IngestionStatus.Cloning => "bg-info",
        IngestionStatus.Analyzing => "bg-primary",
        _ => "bg-primary"
    };

    public void Dispose()
    {
        _pollingTimer?.Dispose();
    }
    
    [Inject] IJSRuntime? JSRuntime { get; set; }
}

<style>
    .form-control::placeholder {
        color: #6c757d;
        opacity: 0.5;
        font-weight: 300;
    }
</style>
