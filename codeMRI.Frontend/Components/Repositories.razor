@code {
    private List<string> repositories = new();
    private bool isLoading = true;
    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            repositories = await WikiApi.GetRepositoriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching repos: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Ensure UI updates immediately
        }

        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/wikiHub"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<codeMRI.Server.Api.ProgressInfo>("ReceiveProgress", (info) =>
            {
                AppState.SetProgress(info);
                InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
             Console.WriteLine($"Warning: Failed to connect to WikiHub: {ex.Message}");
        }
    }

    private async Task SelectRepo(string path)
    {
        AppState.SetRepoPath(path);
        AppState.SetBusy(true, "Loading structure...");
        try
        {
            var structure = await WikiApi.GenerateStructureAsync(path);
            AppState.SetStructure(structure);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading structure: {ex.Message}");
        }
        finally
        {
            AppState.SetBusy(false);
        }
    }

    private async Task GenerateAdvanced(string path)
    {
        AppState.SetBusy(true, "Starting advanced generation...");
        AppState.SetProgress(new codeMRI.Server.Api.ProgressInfo { Phase = "Init", Message = "Starting...", Percentage = 0 });
        
        try
        {
            var connectionId = hubConnection?.ConnectionId;
            var structure = await WikiApi.GenerateAdvancedStructureAsync(path, connectionId);
            
            AppState.SetRepoPath(path); // Automatically select it when done
            AppState.SetStructure(structure);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating advanced wiki: {ex.Message}");
            AppState.SetProgress(new codeMRI.Server.Api.ProgressInfo { Phase = "Error", Message = ex.Message, Percentage = 0 });
        }
        finally
        {
            AppState.SetBusy(false);
            AppState.SetProgress(null);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
