@using codeMRI.Frontend.Services
@using codeMRI.Server.Api
@inject AppState AppState

<div class="card shadow-sm h-100">
    <div class="card-header bg-light">
        <h6 class="mb-0">Task Delegation</h6>
    </div>
    <div class="card-body overflow-auto p-0" style="max-height: 300px;">
        <div class="list-group list-group-flush">
            @foreach (var evt in AppState.DelegationHistory.AsEnumerable().Reverse())
            {
                <div class="list-group-item">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-secondary me-2">@evt.FromAgent</span>
                        <i class="bi bi-arrow-right text-muted mx-2"></i>
                        <span class="badge bg-primary me-2">@evt.ToAgent</span>
                    </div>
                    <div class="small text-muted mt-1">@evt.Reason</div>
                </div>
            }
             @if (AppState.DelegationHistory.Count == 0)
            {
                <div class="p-3 text-center text-muted small">No tasks delegated yet.</div>
            }
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
