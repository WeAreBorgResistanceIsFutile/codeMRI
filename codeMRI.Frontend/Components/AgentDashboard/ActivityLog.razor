@using codeMRI.Core.Models
@inject AppState AppState

<div class="card shadow-sm h-100">
    <div class="card-header bg-light">
        <h6 class="mb-0">Activity Log</h6>
    </div>
    <div class="card-body overflow-auto p-0" style="max-height: 300px; font-family: monospace; font-size: 0.85em;">
        <ul class="list-group list-group-flush">
            @foreach (var evt in AppState.TaskEvents.AsEnumerable().Reverse())
            {
                <li class="list-group-item @GetEventClass(evt)">
                    <span class="text-muted small me-2">@evt.Timestamp.ToString("HH:mm:ss")</span>
                    <strong>[@evt.Role]</strong>
                    @if (!string.IsNullOrEmpty(evt.TaskType))
                    {
                        <span>started @evt.TaskType</span>
                    }
                    @if (evt.Success)
                    {
                        <span>completed task</span>
                    }
                    @if (!string.IsNullOrEmpty(evt.Error))
                    {
                        <span class="text-danger">failed: @evt.Error</span>
                    }
                </li>
            }
            @if (AppState.TaskEvents.Count == 0)
            {
                <div class="p-3 text-center text-muted small">No activity yet.</div>
            }
        </ul>
    </div>
</div>

@code {

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private string GetEventClass(TaskLifecycleEvent evt)
    {
        if (!string.IsNullOrEmpty(evt.Error)) return "list-group-item-danger";
        if (evt.Success) return "list-group-item-success";
        return "";
    }

}
