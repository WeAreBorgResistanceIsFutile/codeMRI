@inherits LayoutComponentBase
@inject AppState AppState
@implements IDisposable

<div class="app-container">
    <!-- Header -->
    <header class="top-bar">
        <div class="brand">
            <span class="logo-icon">C</span> codeMRI
        </div>
        <div class="context-pill">
            @if (!string.IsNullOrEmpty(AppState.RepoPath))
            {
                <span class="repo-icon">📂</span> @AppState.RepoPath
            }
            else
            {
                <span class="text-muted">Select Repository</span>
            }
        </div>
        <div class="actions">
             <div class="status-wrapper @(AppState.IsBusy ? "busy" : "")">
                <div class="status-dot"></div>
                 @if(AppState.IsBusy) { <span class="status-text ms-2">@AppState.BusyMessage</span> }
            </div>
        </div>
    </header>

    <!-- Workspace -->
    <main class="workspace-grid">
        <!-- Left: Explorer -->
        <aside class="sidebar-pane left-pane">
            <div class="pane-header">EXPLORER</div>
            <div class="pane-content custom-scrollbar p-0">
                @if (!string.IsNullOrEmpty(AppState.RepoPath))
                {
                    <WikiTree />
                }
                else
                {
                    <div class="empty-state-sidebar">
                        <small>No repo selected</small>
                    </div>
                }
            </div>
        </aside>

        <!-- Center: Content -->
        <section class="content-pane">
            @Body
        </section>

        <!-- Right: Assistant -->
        <aside class="sidebar-pane right-pane">
            <div class="pane-header">ASSISTANT</div>
            <div class="pane-content p-0">
                <ChatPanel />
            </div>
        </aside>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
