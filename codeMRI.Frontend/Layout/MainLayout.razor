@inherits LayoutComponentBase
@inject AppState AppState
@implements IDisposable

<div class="app-container">
    <!-- Header -->
    <header class="top-bar">
        <div class="brand">
            <span class="logo-icon">C</span> codeMRI
        </div>
        @if (!string.IsNullOrEmpty(AppState.RepoPath))
        {
            <div class="context-pill">
                <span class="repo-icon">📂</span> @AppState.RepoPath
            </div>
        }
        <div class="actions">
            <a href="ingestions" title="Monitor Ingestions"
               style="color: rgba(255,255,255,0.7); text-decoration: none; margin-right: 20px; font-size: 0.9rem; display: flex; align-items: center; gap: 6px;">
                <span>📊</span> Monitor
            </a>
            @if (string.IsNullOrEmpty(AppState.RepoPath))
            {
                <span class="text-muted" style="font-size: 0.85rem; margin-right: 12px;">Select Repository</span>
            }
            <div class="status-wrapper @(AppState.IsBusy ? "busy" : "")">
                <div class="status-dot"></div>
                @if (AppState.IsBusy)
                {
                    <span class="status-text ms-2">@AppState.BusyMessage</span>
                }
            </div>
        </div>
    </header>

    <!-- Workspace -->
    <main class="workspace-grid">
        <!-- Left: Explorer -->
        <aside class="sidebar-pane left-pane">
            <div class="pane-header">EXPLORER</div>
            <div class="pane-content custom-scrollbar p-0">
                @if (!string.IsNullOrEmpty(AppState.RepoPath))
                {
                    <WikiTree/>
                }
                else
                {
                    <div class="empty-state-sidebar">
                        <small>No repo selected</small>
                    </div>
                }
            </div>
        </aside>

        <!-- Resizer Left -->
        <div class="resizer-handle resizer-left" onmousedown="startResize('left')"></div>

        <!-- Center: Content -->
        <section class="content-pane">
            @Body
        </section>

        <!-- Resizer Right -->
        <div class="resizer-handle resizer-right" onmousedown="startResize('right')"></div>

        <!-- Right: Assistant -->
        <aside class="sidebar-pane right-pane">
            <div class="pane-header">ASSISTANT</div>
            <div class="pane-content p-0">
                <ChatPanel/>
            </div>
        </aside>
    </main>
</div>

@code {

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

}
