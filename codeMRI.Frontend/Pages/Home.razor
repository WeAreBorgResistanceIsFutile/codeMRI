@page "/"
@inject AppState AppState
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@if (string.IsNullOrEmpty(AppState.RepoPath))
{
    <!-- No repository selected - show landing page -->
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
        <div class="text-center mb-4">
            <h1 class="display-5 mb-3">Welcome to codeMRI</h1>
            <p class="lead text-muted mb-4">Select a repository to view its documentation</p>
            <button class="btn btn-primary btn-lg" @onclick="NavigateToRepositories">
                Browse Repositories
            </button>
        </div>
    </div>
}
else if (AppState.CurrentPage == null)
{
    <div class="empty-state-start">
        <h1 class="display-4" style="font-family: 'Google Sans'">Welcome</h1>
        <p class="lead">Select a page from the explorer to begin.</p>
    </div>
}
else
{
    <div class="document-view">
        <div class="view-header d-flex justify-content-end mb-3 gap-2">
            @if (isEditing)
            {
                <button class="btn btn-success btn-sm px-3 shadow-sm d-flex align-items-center" @onclick="SaveContent">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                        <path d="M11 2H9v3h2z"/>
                        <path d="M1.5 0h11.586a1.5 1.5 0 0 1 1.06.44l1.415 1.414A1.5 1.5 0 0 1 16 2.914V14.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5v-13A1.5 1.5 0 0 1 1.5 0M1 1.5v13a.5.5 0 0 0 .5.5H2v-4.5A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5V15h.5a.5.5 0 0 0 .5-.5V2.914a.5.5 0 0 0-.146-.353l-1.415-1.415A.5.5 0 0 0 13.086 1H13v4.5A1.5 1.5 0 0 1 11.5 7h-7A1.5 1.5 0 0 1 3 5.5V1H1.5a.5.5 0 0 0-.5.5m3-.5v4.5a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V1zM3 15h10v-4.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5z"/>
                    </svg>
                    Save Changes
                </button>
                <button class="btn btn-outline-secondary btn-sm px-3 shadow-sm d-flex align-items-center" @onclick="ToggleEdit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                    Cancel
                </button>
            }
            else
            {
                <button class="btn btn-outline-primary btn-sm px-3 shadow-sm d-flex align-items-center" @onclick="ToggleEdit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                    </svg>
                    Edit Raw
                </button>
                <button class="btn btn-outline-secondary btn-sm px-3 shadow-sm d-flex align-items-center" @onclick="RegeneratePage">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                    </svg>
                    AI Rewrite
                </button>
            }
        </div>

        @if (isEditing)
        {
            <div class="editor-container shadow-sm border rounded">
                <textarea class="form-control markdown-editor" 
                          @bind="editingContent"
                          @bind:event="oninput"
                          spellcheck="false"
                          placeholder="Enter markdown content..."></textarea>
            </div>
        }
        else
        {
            <div class="markdown-content">
                @((MarkupString)Markdown.ToHtml(AppState.CurrentPage.Content ?? "", Pipeline))
            </div>
        }
    </div>
}

<style>
    .markdown-editor {
        font-family: 'Cascadia Code', 'Fira Code', 'Roboto Mono', monospace;
        font-size: 0.95rem;
        height: calc(100vh - 250px);
        min-height: 500px;
        resize: none;
        border: none;
        padding: 1.5rem;
        background-color: #fcfcfc;
        color: #2c3e50;
        line-height: 1.6;
    }

    .markdown-editor:focus {
        background-color: #fff;
        box-shadow: none;
        outline: none;
    }
    
    .editor-container {
        overflow: hidden;
        background: #fff;
    }
    
    .view-header .btn {
        transition: all 0.2s ease;
        border-radius: 6px;
        font-weight: 500;
    }
    
    .view-header .btn:hover {
        transform: translateY(-1px);
    }
</style>

@code {
    private WikiPage? lastPage;
    private bool isEditing;
    private string editingContent = "";

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Check if page changed effectively tracking state changes for scroll reset
        if (AppState.CurrentPage != lastPage)
        {
            lastPage = AppState.CurrentPage;
            isEditing = false; // Reset editing mode when switching pages
            // Reset scroll of the content pane when page changes
            await JSRuntime.InvokeVoidAsync("scrollToTop", ".content-pane");
        }

        if (AppState.CurrentPage != null)
        {
            // Small delay to ensure markdown content is fully in DOM
            await Task.Delay(100);
            await JSRuntime.InvokeVoidAsync("renderMermaidDiagrams");
            await JSRuntime.InvokeVoidAsync("adjustPopovers");
        }
    }

    private void NavigateToRepositories()
    {
        Navigation.NavigateTo("/repositories");
    }

}

@implements IDisposable

@functions {

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    void ClosePage()
    {
        AppState.SetCurrentPage(null!);
    }

    [Inject] WikiApiClient WikiApi { get; set; } = default!;

    async Task RegeneratePage()
    {
        if (AppState.CurrentPage == null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            "Are you sure? This will discard the current page content and ask the AI to rewrite it from the original source files.");
        
        if (!confirmed) return;

        AppState.SetBusy(true, "Regenerating page...");
        try
        {
            var newPage = await WikiApi.GeneratePageAsync(
                AppState.RepoPath,
                AppState.CurrentPage.Title,
                AppState.CurrentPage.RelevantFiles,
                true
            );
            AppState.SetCurrentPage(newPage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error regenerating page: {ex.Message}");
        }
        finally
        {
            AppState.SetBusy(false);
        }
    }

    void ToggleEdit()
    {
        if (!isEditing)
        {
            editingContent = AppState.CurrentPage?.Content ?? "";
        }
        isEditing = !isEditing;
    }

    async Task SaveContent()
    {
        if (AppState.CurrentPage == null) return;

        AppState.SetBusy(true, "Saving changes...");
        try
        {
            var updatedPage = AppState.CurrentPage;
            updatedPage.Content = editingContent;
            
            await WikiApi.SavePageAsync(AppState.RepoPath, updatedPage);
            AppState.SetCurrentPage(updatedPage);
            isEditing = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving page: {ex.Message}");
        }
        finally
        {
            AppState.SetBusy(false);
        }
    }

}
