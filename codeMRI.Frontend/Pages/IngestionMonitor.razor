@page "/ingestions"
@inject WikiApiClient WikiApi
@inject IJSRuntime JSRuntime
@using System.Threading
@implements IDisposable

<div class="monitor-container fade-in">
    <div class="header-section">
        <h1>Ingestion Monitor</h1>
        <p class="text-muted">Track ongoing repository ingestions in real-time.</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <span>Loading active ingestions...</span>
        </div>
    }
    else if (jobs.Count == 0)
    {
        <div class="empty-state">
            <span class="icon">🔍</span>
            <h3>No Active Ingestions</h3>
            <p>There are no jobs currently running. Start an ingestion from the home page.</p>
            <a href="/" class="btn-primary">Go to Home</a>
        </div>
    }
    else
    {
        <div class="jobs-grid">
            @foreach (var job in jobs)
            {
                <div class="job-card @GetStatusClass(job.Status)">
                    <div class="card-header">
                        <div class="repo-info">
                            <span class="repo-icon">📦</span>
                            <span class="repo-name" title="@job.RepoUrl">
                                @(string.IsNullOrEmpty(job.RepoName) ? job.RepoUrl : job.RepoName)
                            </span>
                        </div>
                        <span class="status-badge @GetStatusClass(job.Status)">@job.Status</span>
                    </div>

                    <div class="card-body">
                        <div class="phase-info">
                            <span class="label">Current Phase:</span>
                            <span class="value">@job.CurrentPhase</span>
                        </div>

                        <div class="progress-section">
                            <div class="progress-bar-container">
                                <div class="progress-bar" style="width: @(job.ProgressPercentage)%"></div>
                            </div>
                            <span class="percentage">@job.ProgressPercentage%</span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(job.Message))
                        {
                            <div class="message-log">
                                <small>@job.Message</small>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(job.Error))
                        {
                            <div class="error-alert">
                                ⚠️ @job.Error
                            </div>
                        }
                    </div>

                    <div class="card-actions">
                        @if (IsCancellable(job.Status))
                        {
                            <button class="btn-cancel" @onclick="@(() => CancelJob(job.Id))" disabled="@(job.Status == IngestionStatus.Cancelling)">
                                @(job.Status == IngestionStatus.Cancelling ? "Cancelling..." : "Cancel Job")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .monitor-container {
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .header-section {
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 1rem;
    }

    .header-section h1 {
        font-size: 2rem;
        font-weight: 300;
        color: #fff;
        margin-bottom: 0.5rem;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
        border: 1px dashed rgba(255,255,255,0.1);
    }

    .empty-state .icon {
        font-size: 3rem;
        display: block;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .jobs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 1.5rem;
    }

    .job-card {
        background: #1e1e1e;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .job-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }

    .card-header {
        padding: 1rem;
        background: rgba(0,0,0,0.2);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .repo-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        overflow: hidden;
    }

    .repo-name {
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #e0e0e0;
    }

    .card-body {
        padding: 1.25rem;
    }

    .phase-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    .phase-info .label { color: #888; }
    .phase-info .value { color: #ccc; font-weight: 500; }

    .progress-section {
        margin-bottom: 1rem;
    }

    .progress-bar-container {
        height: 6px;
        background: rgba(255,255,255,0.1);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .progress-bar {
        height: 100%;
        background: #3b82f6;
        transition: width 0.3s ease;
    }

    .percentage {
        font-size: 0.8rem;
        color: #888;
        float: right;
    }

    .message-log {
        font-family: monospace;
        font-size: 0.8rem;
        color: #666;
        background: rgba(0,0,0,0.2);
        padding: 0.5rem;
        border-radius: 4px;
        margin-top: 1rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .error-alert {
        margin-top: 1rem;
        padding: 0.75rem;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #f87171;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .card-actions {
        padding: 1rem;
        border-top: 1px solid rgba(255,255,255,0.05);
        text-align: right;
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid rgba(239, 68, 68, 0.5);
        color: #ef4444;
        padding: 0.4rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.9rem;
    }

    .btn-cancel:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.1);
    }
    
    .btn-cancel:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 99px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .status-badge.Queued { background: rgba(255,255,255,0.1); color: #ccc; }
    .status-badge.Cloning { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
    .status-badge.Analyzing { background: rgba(168, 85, 247, 0.2); color: #c084fc; }
    .status-badge.Generating { background: rgba(234, 179, 8, 0.2); color: #facc15; }
    .status-badge.Completed { background: rgba(34, 197, 94, 0.2); color: #4ade80; }
    .status-badge.Failed { background: rgba(239, 68, 68, 0.2); color: #f87171; }
    .status-badge.Cancelling { background: rgba(249, 115, 22, 0.2); color: #fb923c; }
    .status-badge.Cancelled { background: rgba(107, 114, 128, 0.2); color: #9ca3af; }

    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 200px;
        color: #888;
    }
    
    .spinner {
        width: 30px;
        height: 30px;
        border: 3px solid rgba(255,255,255,0.1);
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
    }
    
    @@keyframes spin { to { transform: rotate(360deg); } }

    .btn-primary {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.6rem 1.2rem;
        background: #3b82f6;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 500;
        transition: background 0.2s;
    }
    .btn-primary:hover {
        background: #2563eb;
    }
</style>

@code {
    private List<IngestionJob> jobs = new();
    private Timer? timer;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadJobs();
        isLoading = false;
        
        // Start polling every 2 seconds
        timer = new Timer(async _ => 
        {
            await InvokeAsync(async () => 
            {
                await LoadJobs();
                StateHasChanged();
            });
        }, null, 2000, 2000);
    }

    private async Task LoadJobs()
    {
        try 
        {
            jobs = await WikiApi.ListActiveIngestionsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading jobs: {ex.Message}");
        }
    }

    private async Task CancelJob(string jobId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this ingestion?"))
        {
            await WikiApi.CancelIngestionAsync(jobId);
            // Immediate refresh
            await LoadJobs();
        }
    }

    private string GetStatusClass(IngestionStatus status) => status.ToString();

    private bool IsCancellable(IngestionStatus status)
    {
        return status != IngestionStatus.Completed && 
               status != IngestionStatus.Failed && 
               status != IngestionStatus.Cancelled && 
               status != IngestionStatus.Cancelling;
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
