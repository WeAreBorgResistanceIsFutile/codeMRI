@page "/benchmarks"
@using codeMRI.Core.Models
@using codeMRI.Frontend.Services
@inject WikiApiClient WikiApi
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<div class="container mx-auto p-4">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Benchmark Runs</h1>
        <button class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded shadow" 
                @onclick="ShowStartBenchmarkModal">
            Start Benchmark
        </button>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center items-center h-64">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500"></div>
        </div>
    }
    else if (benchmarks == null || !benchmarks.Any())
    {
        <div class="bg-gray-100 rounded-lg p-8 text-center text-gray-500">
            <p class="text-xl">No benchmarks found.</p>
            <p class="mt-2">Start a new benchmark run to see results here.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto shadow-md rounded-lg bg-white">
            <table class="min-w-full leading-normal">
                <thead>
                    <tr>
                        <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Name / Repo
                        </th>
                        <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Status
                        </th>
                        <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Metrics (Q/T/D)
                        </th>
                        <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Start Time
                        </th>
                        <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in benchmarks.OrderByDescending(b => b.StartTime))
                    {
                        <tr>
                            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                <div class="flex items-center">
                                    <div class="ml-3">
                                        <p class="text-gray-900 whitespace-no-wrap font-bold">
                                            <a href="/benchmarks/@run.Id" class="hover:underline text-blue-600">@run.Name</a>
                                        </p>
                                        <p class="text-gray-600 whitespace-no-wrap text-xs">@run.RepositoryName</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                <span class="@GetStatusBadgeClass(run.Status)">
                                    @run.Status
                                </span>
                                @if (run.Status == BenchmarkStatus.Running)
                                {
                                    <div class="w-full bg-gray-200 rounded-full h-1.5 mt-2">
                                        <div class="bg-blue-600 h-1.5 rounded-full" style="width: @(run.ProgressPercentage)%"></div>
                                    </div>
                                }
                            </td>
                            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                <div class="flex flex-col space-y-1">
                                    <span title="Quality Score" class="text-green-600 font-semibold">Q: @run.MeanQualityScore.ToString("F2")</span>
                                    <span title="Total Tokens" class="text-gray-600 text-xs">T: @(run.TotalTokens / 1000)k</span>
                                    <span title="Duration" class="text-gray-600 text-xs">D: @run.TotalDuration.ToString(@"hh\:mm\:ss")</span>
                                </div>
                            </td>
                            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                <p class="text-gray-900 whitespace-no-wrap">@run.StartTime.ToLocalTime().ToString("g")</p>
                            </td>
                            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                <div class="flex space-x-2">
                                    <a href="/benchmarks/@run.Id" class="text-blue-600 hover:text-blue-900">View</a>
                                    
                                    @if (run.Status == BenchmarkStatus.Running)
                                    {
                                        <button @onclick="() => PauseBenchmark(run.Id)" class="text-yellow-600 hover:text-yellow-900">Pause</button>
                                    }
                                    else if (run.Status == BenchmarkStatus.Paused)
                                    {
                                        <button @onclick="() => ResumeBenchmark(run.Id)" class="text-green-600 hover:text-green-900">Resume</button>
                                    }
                                    
                                    <button @onclick="() => DeleteBenchmark(run.Id)" class="text-red-600 hover:text-red-900">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showStartModal)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full" id="my-modal">
        <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="mt-3 text-center">
                <h3 class="text-lg leading-6 font-medium text-gray-900">Start New Benchmark</h3>
                <div class="mt-2 px-7 py-3">
                    <input @bind="newBenchmarkRepo" placeholder="Repository URL (e.g. https://github.com/owner/repo)" 
                           class="mb-3 px-3 py-2 border rounded w-full text-gray-700 focus:outline-none" />
                    <input @bind="newBenchmarkName" placeholder="Run Name (Optional)" 
                           class="mb-3 px-3 py-2 border rounded w-full text-gray-700 focus:outline-none" />
                    <!-- Configuration selection could go here, omitting for simplicity/default -->
                </div>
                <div class="items-center px-4 py-3">
                    <button id="ok-btn" @onclick="StartBenchmark" class="px-4 py-2 bg-blue-500 text-white text-base font-medium rounded-md w-full shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-300">
                        Start
                    </button>
                    <button id="cancel-btn" @onclick="CloseStartModal" class="mt-3 px-4 py-2 bg-gray-100 text-gray-700 text-base font-medium rounded-md w-full shadow-sm hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-300">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BenchmarkRun>? benchmarks;
    private bool isLoading = true;
    private bool showStartModal = false;
    private string newBenchmarkRepo = string.Empty;
    private string newBenchmarkName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBenchmarks();
    }

    private async Task LoadBenchmarks()
    {
        try
        {
            isLoading = true;
            benchmarks = await WikiApi.ListBenchmarksAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading benchmarks: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowStartBenchmarkModal()
    {
        showStartModal = true;
        newBenchmarkRepo = string.Empty;
        newBenchmarkName = string.Empty;
    }

    private void CloseStartModal()
    {
        showStartModal = false;
    }

    private async Task StartBenchmark()
    {
        if (string.IsNullOrWhiteSpace(newBenchmarkRepo)) return;

        try
        {
            var request = new StartBenchmarkRequest
            {
                RepositoryUrl = newBenchmarkRepo,
                Name = string.IsNullOrWhiteSpace(newBenchmarkName) ? $"Run {DateTime.Now:yyyyMMdd-HHmm}" : newBenchmarkName,
                ModelConfiguration = "{}" // Default for now
            };
            
            await WikiApi.StartBenchmarkAsync(request);
            showStartModal = false;
            await LoadBenchmarks();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting benchmark: {ex.Message}");
        }
    }

    private async Task DeleteBenchmark(string runId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this benchmark run?"))
            return;

        try
        {
            await WikiApi.DeleteBenchmarkAsync(runId);
            await LoadBenchmarks();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting benchmark: {ex.Message}");
        }
    }

    private async Task PauseBenchmark(string runId)
    {
        try
        {
            await WikiApi.PauseBenchmarkAsync(runId);
            await LoadBenchmarks();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error pausing benchmark: {ex.Message}");
        }
    }

    private async Task ResumeBenchmark(string runId)
    {
        try
        {
            await WikiApi.ResumeBenchmarkAsync(runId);
            await LoadBenchmarks();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resuming benchmark: {ex.Message}");
        }
    }

    private string GetStatusBadgeClass(BenchmarkStatus status)
    {
        return status switch
        {
            BenchmarkStatus.Running => "relative inline-block px-3 py-1 font-semibold text-blue-900 leading-tight bg-blue-200 rounded-full",
            BenchmarkStatus.Completed => "relative inline-block px-3 py-1 font-semibold text-green-900 leading-tight bg-green-200 rounded-full",
            BenchmarkStatus.Failed => "relative inline-block px-3 py-1 font-semibold text-red-900 leading-tight bg-red-200 rounded-full",
            BenchmarkStatus.Paused => "relative inline-block px-3 py-1 font-semibold text-yellow-900 leading-tight bg-yellow-200 rounded-full",
            BenchmarkStatus.Cancelled => "relative inline-block px-3 py-1 font-semibold text-gray-900 leading-tight bg-gray-200 rounded-full",
            _ => "relative inline-block px-3 py-1 font-semibold text-gray-900 leading-tight bg-gray-200 rounded-full"
        };
    }

    // Injection handled via @inject directive
}
