{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} [{CallerMemberName} at {CallerFilePath}:{CallerLineNumber}]{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} [{CallerMemberName} at {CallerFilePath}:{CallerLineNumber}]{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WikiDb": "Data Source=../data/sqlite/codemri.db",
    "IngestionDb": "Data Source=../data/sqlite/codemri.db"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ContextSize": 16000,
    "Temperature": 0.2
  },
  "Retry": {
    "MaxRetries": 5,
    "BaseDelayMilliseconds": 5000,
    "MaxDelayMilliseconds": 50000
  },
  "ModelRouting": {
    "DocumentationModel": "nemotron-3-nano:30b-cloud",
    "ChatModel": "mistral-large-3:675b-cloud",
    "JudgeModels": [
      "mistral-large-3:675b-cloud",
      "kimi-k2-thinking:cloud",
      "deepseek-v3.1:671b-cloud",
      "cogito-2.1:671b-cloud",
      "minimax-m2.1:cloud"
    ],
    "EnableModelRouting": true,
    "EnableEnsembleGeneration": true,
    "CodeAnalysisModel": "devstral-small-2:24b-cloud",
    "NaturalLanguageModel": "ministral-3:14b-cloud",
    "SynthesisJudgeModel": "ministral-3:14b-cloud",
    "EnsembleModels": [
      "qwen3-coder:480b-cloud",
      "devstral-2:123b-cloud",
      "kimi-k2-thinking:cloud",
      "deepseek-v3.1:671b-cloud",
      "minimax-m2.1:cloud",
      "cogito-2.1:671b-cloud",
      "nemotron-3-nano:30b-cloud",
      "qwen3-next:80b-cloud",
      "gemma3:27b-cloud"
    ],
    "MinimumAgreementThreshold": 2
  },
  "ASTService": {
    "BaseUrl": "http://localhost:3000",
    "TimeoutSeconds": 30,
    "Enabled": true
  },
  "Delegation": {
    "EnableDelegation": true,
    "MaxComplexityScore": 100,
    "MaxDelegationDepth": 3,
    "SemanticDiversityThreshold": 0.6,
    "ContextUtilizationRatio": 0.8
  },
  "VectorStore": {
    "Host": "localhost",
    "Port": 6334,
    "UseHttps": false,
    "Collections": {
      "Documentation": "documentation",
      "Code": "code"
    }
  },
  "Embedding": {
    "Model": "nomic-embed-text:latest",
    "BatchSize": 20,
    "Chunking": {
      "MaxTokens": 2048,
      "OverlapTokens": 100
    }
  },
  "CodeWiki": {
    "GenerateAllPages": false,
    "MaxDegreeOfParallelism": 5,
    "EnableRevisionLoop": true,
    "MinChildrenForRevision": 2
  }
}